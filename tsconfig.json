{
    "compilerOptions": {
        "target": "ES2017",
        "lib": [
            "ES2017",
            "DOM"
        ],
        "typeRoots": [
            "./node_modules/@types",
            "./node_modules/@figma"
        ],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "module": "None",
        "noEmit": false,
        "rootDir": "."
    },
    "include": [
        "code.ts"
    ],
    "exclude": []
}